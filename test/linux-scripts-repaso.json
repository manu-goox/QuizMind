      "id": "q1",
      "text": "¿Qué lista la orden `ls cap*.2` tras ejecutar creacap?",
      "type": "single",
      "answers": [
        { "id": "a1", "text": "cap1.2, cap2.2, ..., cap10.2 (10 ficheros)", "correct": true },
        { "id": "a2", "text": "cap1.2 .. cap9.2 (9 ficheros)" },
        { "id": "a3", "text": "Solo cap10.2" },
        { "id": "a4", "text": "Todos los ficheros cap" }
      ],
      "explanation": "cap*.2 casa cualquier nombre cap + cualquier cosa + .2; incluye cap10.2."
    },
    {
      "id": "q2",
      "text": "¿Qué borra la orden `rm cap?`?",
      "type": "single",
      "answers": [
        { "id": "a1", "text": "cap1..cap9 (9 ficheros)", "correct": true },
        { "id": "a2", "text": "cap1..cap10 (10 ficheros)" },
        { "id": "a3", "text": "Los .1 y .2 de cada cap" },
        { "id": "a4", "text": "Nada" }
      ],
      "explanation": "cap? exige exactamente 4 caracteres: cap1..cap9. cap10 tiene 5 y no coincide."
    },
    {
      "id": "q3",
      "text": "¿Cuántos ficheros borra `rm cap*`?",
      "type": "single",
      "answers": [
        { "id": "a1", "text": "30", "correct": true },
        { "id": "a2", "text": "10" },
        { "id": "a3", "text": "9" },
        { "id": "a4", "text": "20" }
      ],
      "explanation": "cap* casa capN, capN.1 y capN.2 de los 10 capítulos: 30."
    },
