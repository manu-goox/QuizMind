{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "QuizMind",
  "version": "0.1.6",
  "identifier": "com.manugoox.quizmind",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "QuizMind",
        "width": 1200,
        "height": 820,
        "minWidth": 520,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "decorations": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2OUM3OUFGNjhENjNBMkIKUldRck90Wm9yM21jeHQ0YXRXcXBpbVQ2cTFReE5XektUcVBva1A0VlJEZzJ2UDdZcXVJd2V4VjAK",
      "endpoints": [
        "https://github.com/manu-goox/QuizMind/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
